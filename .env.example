# Google OAuth 2.0 desktop/web application credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Preferred for MCP runtime. Keep this secret out of source control.
GOOGLE_REFRESH_TOKEN=

# Optional encrypted/permission-restricted token file created by npm run auth:init.
# If GOOGLE_REFRESH_TOKEN is empty, this file is used when present.
GMAIL_TOKEN_PATH=.credentials/gmail-token.json

# Default: Gmail scopes plus drive.readonly for meeting-notes docs and contacts.readonly for recipient resolution.
# If you customized GOOGLE_SCOPES, append https://www.googleapis.com/auth/drive.readonly
# and https://www.googleapis.com/auth/contacts.readonly
# and re-run `npm run auth:init` so the grant includes them.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/contacts.readonly

# Audit log. Use an absolute path for a system/service deployment.
AUDIT_LOG_PATH=./audit.log
# Single-slot rotation buffer: when audit.log exceeds this size it moves to audit.log.1.
MAX_AUDIT_BYTES=10485760

# Local semantic search (Transformers.js, multilingual). First run downloads the model once.
SEMANTIC_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_INDEX_PATH=.cache/gmail-semantic-index.json
SEMANTIC_INDEX_TTL_HOURS=24
MAX_INDEX_THREADS=500

# Safety limits
MAX_RECIPIENTS=20
MAX_CONTACTS_RESULTS=10
MAX_ATTACHMENT_BYTES=1000000
# Per-file cap for outgoing attachments (gmail_send_message_strict / gmail_create_draft).
MAX_SEND_ATTACHMENT_BYTES=10000000
MAX_SUBJECT_LENGTH=998
MAX_BODY_LENGTH=200000
MAX_MESSAGE_BODY_CHARS=20000
MAX_THREAD_BODY_CHARS=60000

# Optional allowlist. Comma-separated domains; leave empty for no domain restriction.
# ALLOWED_RECIPIENT_DOMAINS=company.com,subsidiary.com

# Optional allowlist for local attachment/inline-image paths.
# Strongly recommended: without it, the server can read any file the OS user can read.
# ALLOWED_ATTACHMENT_DIRS=/home/you/Documents,/srv/gmail-mcp/attachments
