{
  "name": "gmail-secure-mcp",
  "version": "1.1.0",
  "description": "Enterprise-grade secure Gmail MCP server with soft-delete, draft-first sending, sanitized context, and JSONL audit logging.",
  "type": "module",
  "license": "MIT",
  "author": "Santos Rojas",
  "keywords": [
    "mcp",
    "gmail",
    "model-context-protocol",
    "oauth",
    "audit-log",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SantosRojas/gmail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SantosRojas/gmail-mcp/issues"
  },
  "homepage": "https://github.com/SantosRojas/gmail-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth:init": "tsx src/auth/setupAuth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "dotenv": "^18.0.5",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
